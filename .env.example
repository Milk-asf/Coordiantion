# Required — Supabase project credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Required for team invites and auth callback
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Recommended — Public site URL used for auth email redirects.
# Set this in Vercel to your production URL (e.g. https://your-app.vercel.app).
# Without it, server-side auth flows fall back to VERCEL_PROJECT_PRODUCTION_URL
# or localhost. Client-side flows use window.location.origin.
NEXT_PUBLIC_SITE_URL=https://coordiantion.vercel.app

# Optional — Invoice email delivery (via Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=invoices@yourdomain.com

# Required for third-party integrations (e.g. Xero) — encrypts stored tokens at rest.
# Must be a base64-encoded 32-byte key. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep this secret and never commit it.
INTEGRATION_ENCRYPTION_KEY=

# Xero integration (OAuth 2.0). Create an app at https://developer.xero.com.
# XERO_REDIRECT_URI must EXACTLY match a redirect URI registered in the Xero app.
#   Local:      http://localhost:3000/api/xero/callback
#   Production: https://app-kinsa.com.au/api/xero/callback
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://localhost:3000/api/xero/callback
# Webhook signing key from the Xero app's Webhooks tab (only needed for status tracking).
XERO_WEBHOOK_KEY=

# Optional — Set to "true" to send the Content-Security-Policy as report-only
# while trialling policy changes. Leave unset in normal operation (enforced).
CSP_REPORT_ONLY=

# Optional — Distributed rate limiting via Upstash Redis (REST). When unset,
# rate limits are enforced per server instance in memory, which is fine for a
# single region. Create a database at https://console.upstash.com.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional — Server errors are POSTed here as JSON (Slack webhook, Better
# Stack, or any collector). Errors are always written to structured logs
# regardless of this setting.
ERROR_WEBHOOK_URL=
