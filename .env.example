# Required — Supabase project credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Required for team invites and auth callback
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Recommended — Public site URL used for auth email redirects.
# Set this in Vercel to your production URL (e.g. https://your-app.vercel.app).
# Without it, server-side auth flows fall back to VERCEL_PROJECT_PRODUCTION_URL
# or localhost. Client-side flows use window.location.origin.
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Optional — Invoice email delivery (via Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=invoices@yourdomain.com
